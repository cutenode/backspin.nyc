@pushOnceTo('css')
  <!-- external CSS links -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Domine:wght@400..700&family=Spline+Sans+Mono:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">
	<!-- CSS reset -->
	<style type="text/css">
	/* 1. Use a more-intuitive box-sizing model */
	*, *::before, *::after {
		box-sizing: border-box;
	}

	/* 2. Remove default margin */
	*:not(dialog) {
		margin: 0;
	}

	/* 3. Enable keyword animations */
	@media (prefers-reduced-motion: no-preference) {
		html {
			interpolate-size: allow-keywords;
		}
	}

	body {
		/* 4. Add accessible line-height */
		line-height: 1.5;
		/* 5. Improve text rendering */
		-webkit-font-smoothing: antialiased;
	}

	/* 6. Improve media defaults */
	img, picture, video, canvas, svg {
		display: block;
		max-width: 100%;
	}

	/* 7. Inherit fonts for form controls */
	input, button, textarea, select {
		font: inherit;
	}

	/* 8. Avoid text overflows */
	p, h1, h2, h3, h4, h5, h6 {
		overflow-wrap: break-word;
	}

	/* 9. Improve line wrapping */
	p {
		text-wrap: pretty;
	}
	h1, h2, h3, h4, h5, h6 {
		text-wrap: balance;
	}

	/*
		10. Create a root stacking context
	*/
	#root, #__next {
		isolation: isolate;
	}
	</style>


	<!-- our custom CSS -->
	<style type="text/css">
		body {
			background-color: #f0f0f0;
			max-width: 800px;
			margin: 0 auto;
		}

		section#hero {
			margin-top: 15rem;
			margin-bottom: 15rem;
			flex-direction: row;
			width: 100%;
		}

		section#hero h1 {
			text-decoration: underline;
			text-align: center;	
			font-size: 10rem;
		}

		section#hero h2 {
			text-align: center;
			font-weight: 600;
		}

		section#hero section {
			margin-top: 5rem;
		}

		.signup {
			max-width: fit-content;
			margin: 2rem auto;
		}

		.signup input[type=email], .signup input[type=submit] {
			margin: 0 auto;
			padding-top: 0;
			padding-bottom: 5px;
			padding-left: 20px;
			padding-right: 20px;
			height: 2.5rem;
			border-radius: 1.5rem;
			border-color: transparent;
		}
		.signup input[type=email] {
			border-color: #f8f8f8;
    border-style: solid;
		}

		.signup input[type=submit] {
			background-color: gainsboro;
		}
		
		/* font styles */

		.header-font {
		  font-family: "Domine", serif;
			font-weight: 700;
			color: #000;
			text-decoration-color: #000;
		}

		h1.header-font a {
			color: #000;
			text-decoration-color: #000;
		}

		.content-font {
		  font-family: "Spline Sans Mono", monospace;
			font-optical-sizing: auto;
			font-weight: 400;
			font-size: 1rem;
		}

		.italic {
			font-style: italic;
		}

		.mono {
			font-family: "Spline Sans Mono", monospace;
			font-optical-sizing: auto;
			font-weight: 500;
			font-style: normal;
		}

		.layered-paper {
			background-color: #FFFEFF;
			max-width: 100%;
			padding: 2rem;
			overflow: hidden;
			margin-bottom: 16px;
			box-shadow: 0px 1px 2px 1px #D3D2D3;
			border-radius: 2px;
		}

		section#edition {
			margin-top: 3rem;
		}

		section#edition header {
			display: flex;
			margin-bottom: 1.5rem;
		}

		section#edition header * {
			flex: 1 1 auto;
		}

		section#edition header h1 {
			font-size: 1rem;
		}
		section#edition header p {
			font-size: 1rem;
			text-align: right;
		}

		section#edition #content {
			margin-bottom: 5rem;
		}

		section#edition #content h2 {
			font-size: 2rem;
		}

		.signup .prompt {
			font-size: 0.9rem;
			text-align: center;
			margin-bottom: 2rem;
		}

	</style>
@end